# Copy to .env.local and fill in. .env.local is git-ignored.
# Firebase console > Project settings > Your apps > Web app > SDK setup and configuration.
# These web config values are public by design.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# reCAPTCHA v3 SITE key (public). Never put the secret key here.
VITE_RECAPTCHA_SITE_KEY=

# Optional. Defaults to the SDK's hybrid default.
VITE_GEMINI_CLOUD_MODEL=

# Local development only. Register it in Firebase console > App Check > Manage debug tokens.
# Never commit a real value.
VITE_APPCHECK_DEBUG_TOKEN=
